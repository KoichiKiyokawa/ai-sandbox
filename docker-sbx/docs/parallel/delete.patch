 }
+func (s *memoryStore) Delete(_ context.Context, id int64) (bool, error) {
+	if s.err != nil {
+		return false, s.err
+	}
+	for i, note := range s.notes {
+		if note.ID == id {
+			s.notes = append(s.notes[:i], s.notes[i+1:]...)
+			return true, nil
+		}
+	}
+	return false, nil
+}
 
